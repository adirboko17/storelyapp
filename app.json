{
  "expo": {
    "name": "Storely",
    "slug": "storely",
    "scheme": "storely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.storely.admin",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Storely מציגה את המיקום שלך על הגלובוס בצפייה החיה."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Storely ניגשת לתמונות כדי להוסיף אותן למוצרים בחנות.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071018",
          "image": "./assets/brand/storely-mark.png",
          "imageWidth": 96
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1a1a1a",
          "enableRemoteNotifications": false,
          "sounds": ["./assets/sounds/sale.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
